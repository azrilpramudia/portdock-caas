// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  role      Role       @default(USER)
  status    UserStatus @default(ACTIVE)
  lastLogin DateTime?  @map("last_login")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  githubToken    String?
  githubUsername String?
  sshPublicKey   String?
  sshPrivateKey  String?

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockoutUntil        DateTime? @map("lockout_until")
  twoFactorSecret     String?   @map("two_factor_secret")
  isTwoFactorEnabled  Boolean   @default(false) @map("is_two_factor_enabled")

  projects         Project[]
  activityLogs     ActivityLog[]
  terminalLogs     TerminalLog[]
  managedDatabases ManagedDatabase[]
  sessions         Session[]

  @@map("users")
}

model Project {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  name           String
  description    String?
  deploymentType DeploymentType @map("deployment_type")
  templateId     AppTemplate    @default(NIXPACKS) @map("template_id")
  repositoryUrl  String?        @map("repository_url")
  branch         String?
  buildCommand   String?        @map("build_command")
  startCommand   String?        @map("start_command")
  domain         String?
  domainExpiresAt DateTime?      @map("domain_expires_at")
  sslExpiresAt   DateTime?      @map("ssl_expires_at")
  envVars        Json?          @map("env_vars")
  status         ProjectStatus  @default(INACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  containers   Container[]
  activityLogs ActivityLog[]
  terminalLogs TerminalLog[]
  deployments  Deployment[]

  @@map("projects")
}

model Container {
  id                String          @id @default(cuid())
  projectId         String          @map("project_id")
  dockerContainerId String?         @unique @map("docker_container_id")
  name              String
  imageName         String          @map("image_name")
  imageTag          String          @default("latest") @map("image_tag")
  subdomain         String?
  internalPort      Int             @map("internal_port")
  hostPort          Int?            @map("host_port")
  memoryLimit       Int?            @map("memory_limit")
  cpuLimit          Float?          @map("cpu_limit")
  restartPolicy     String          @default("unless-stopped") @map("restart_policy")
  volumeMountPath   String?         @map("volume_mount_path")
  status            ContainerStatus @default(STOPPED)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("containers")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  projectId   String?  @map("project_id")
  action      String
  description String?
  status      String   @default("Success")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

model TerminalLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  projectId  String?  @map("project_id")
  command    String
  output     String?
  executedAt DateTime @default(now()) @map("executed_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("terminal_logs")
}

model Deployment {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  status      String   @default("In Progress")
  progress    Int      @default(0)
  startedAt   DateTime @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  domain      String?
  commitHash  String?  @map("commit_hash")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@map("deployments")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  lastActive DateTime @default(now()) @map("last_active")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

enum DatabaseType {
  POSTGRESQL
  MYSQL
  REDIS
  MONGODB
}

model ManagedDatabase {
  id      String       @id @default(cuid())
  userId  String       @map("user_id")
  name    String
  type    DatabaseType
  version String       @default("latest")

  // Credentials
  dbUser     String? @map("db_user")
  dbPassword String? @map("db_password")
  dbName     String? @map("db_name")

  // Docker info
  dockerContainerId String?         @unique @map("docker_container_id")
  internalPort      Int             @map("internal_port")
  hostPort          Int             @map("host_port")
  status            ContainerStatus @default(STOPPED)

  // Resource allocations
  memoryLimit Int?    @default(512) @map("memory_limit")
  cpuLimit    Float?  @default(0.5) @map("cpu_limit")
  volumeName  String? @map("volume_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("managed_databases")
}

enum AppTemplate {
  NIXPACKS
  STATIC_NGINX
  STATIC_APACHE
  PHP_APACHE
}

enum DeploymentType {
  ZIP
  GITHUB
  DOCKERFILE
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
  BUILDING
  FAILED
}

enum ContainerStatus {
  RUNNING
  STOPPED
  BUILDING
  ERROR
  REMOVING
}

model SystemMetric {
  id         String   @id @default(cuid())
  cpu        Float
  ram        Float
  disk       Float?
  networkOut Float?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("system_metrics")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  category  String   @default("general")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
